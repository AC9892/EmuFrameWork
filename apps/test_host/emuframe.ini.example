# EmuFrame Test Host settings. The app creates emuframe.ini beside the EXE.
# Use Settings > Reload Settings after editing. data_directory needs a restart.
audio_enabled=true
volume=1.0
frame_limit=true
integer_scaling=true
preserve_aspect_ratio=true
audio_latency_ms=80
max_audio_backlog_ms=120
window_width=760
window_height=560
data_directory=EmuFrameData
